{
  "name": "retriever-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/retriever-cli",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go vet ./... && test -z \"$(gofmt -l .)\"",
        "cwd": "apps/retriever-cli"
      },
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build ./... && go test -count=1 -run '^$' ./...",
        "cwd": "apps/retriever-cli"
      },
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    },
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go mod download",
        "cwd": "apps/retriever-cli"
      },
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build -trimpath -o dist/retriever ./cmd/retriever",
        "cwd": "apps/retriever-cli"
      },
      "outputs": ["{projectRoot}/dist"],
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    },
    "run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./dist/retriever",
        "cwd": "apps/retriever-cli"
      },
      "dependsOn": ["build"],
      "cache": false
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "if grep -rn --include='*_test.go' -E '\\.Skip\\(' internal cmd tests; then echo 'test:unit forbids skipped tests' >&2; exit 1; fi; go test -count=1 -cover ./...",
        "cwd": "apps/retriever-cli"
      },
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -count=1 -tags integration ./...",
        "cwd": "apps/retriever-cli"
      },
      "cache": false
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go test -count=1 -cover ./... && go test -count=1 -tags integration -cover ./... && go test -count=1 -cover ./internal/core/... | awk '{ print } /coverage:/ { pct = $5; sub(/%/, \"\", pct); if (pct + 0 < 99) { bad = 1 } } END { if (bad) { print \"a core package is below the 99% target\" > \"/dev/stderr\"; exit 1 } }'",
        "cwd": "apps/retriever-cli"
      },
      "cache": false
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gofmt -w .",
        "cwd": "apps/retriever-cli"
      },
      "cache": false
    },
    "format:check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test -z \"$(gofmt -l .)\"",
        "cwd": "apps/retriever-cli"
      },
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          { "command": "npm exec -- nx run retriever-cli:lint", "forwardAllArgs": false },
          { "command": "npm exec -- nx run retriever-cli:typecheck", "forwardAllArgs": false },
          { "command": "npm exec -- nx run retriever-cli:test:unit", "forwardAllArgs": false }
        ],
        "parallel": false,
        "forwardAllArgs": false
      },
      "cache": true,
      "inputs": ["{projectRoot}/**/*.go", "{projectRoot}/go.mod", "{projectRoot}/go.sum"]
    }
  },
  "tags": ["type:app", "platform:cli", "lang:go", "domain:retriever"]
}
