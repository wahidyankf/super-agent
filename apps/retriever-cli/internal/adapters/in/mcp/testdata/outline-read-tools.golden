        "sort": {
          "description": "the field to sort by; the server's default when omitted",
          "enum": [
            "createdAt",
            "updatedAt",
            "publishedAt",
            "index",
            "title",
            "popularityScore"
          ],
          "type": "string"
        },
        "source": {
