          "description": "true to include the text the comments are anchored to",
          "type": "boolean"
        },
        "limit": {
          "description": "items per page, from 1 to 100; 25 when omitted",
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        "offset": {
          "description": "the first item to return; 0 when omitted",
          "minimum": 0,
          "type": "integer"
        },
        "parent_comment_id": {
          "description": "only replies to this comment, by its UUID",
          "type": "string"
        },
        "sort": {
          "description": "the field to sort by; the server's default when omitted",
          "enum": [
            "createdAt",
            "updatedAt"
          ],
          "type": "string"
        },
        "source": {
          "description": "the source ID; may be omitted when exactly one outline source exists",
          "type": "string"
        },
        "status_filter": {
          "description": "only resolved, or only unresolved, comments; comma-separated",
          "items": {
            "enum": [
              "resolved",
              "unresolved"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "name": "list_comments"
