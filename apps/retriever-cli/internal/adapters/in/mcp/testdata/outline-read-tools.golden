          "type": "string"
        },
        "event": {
          "description": "the event to follow; documents.update is the only one",
          "enum": [
            "documents.update"
          ],
          "type": "string"
        },
        "source": {
          "description": "the source ID; may be omitted when exactly one outline source exists",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "get_subscription"
  },
